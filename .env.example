# Development only. Use different keys; no real values belong in Git.
STORAGE_ADMIN_KEY=
STORAGE_API_KEY=
STORAGE_PORT=3210
APP_BASE_URL=http://localhost:3210

# Optional label service (printing). Use this system's client key from the label service.
# Settings saved under Printing > Label service connection take precedence.
LABEL_SERVICE_URL=
LABEL_SERVICE_KEY=

# Optional management-only semantic preview. Disabled by default.
# Requires an explicitly approved native Ollama route for /api/tags and /api/embed.
# These values are not forwarded by the current Compose templates.
STORAGE_SEMANTIC_PREVIEW=0
# STORAGE_EMBEDDING_URL=http://approved-ollama-host:11434
# STORAGE_EMBEDDING_MODEL=bge-m3:cpu4
# STORAGE_EMBEDDING_REVISION=<64-character model digest from /api/tags>
# STORAGE_EMBEDDING_DIMENSIONS=1024
# STORAGE_EMBEDDING_KEY=
# STORAGE_EMBEDDING_CACHE=/data/semantic.sqlite
